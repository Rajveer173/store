# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database (matches docker-compose.yml at the repository root)
DATABASE_URL=postgresql://srp_user:srp_password@localhost:5432/store_ratings
DATABASE_SSL=false

# Auth
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10

# Seed accounts (used by "npm run db:seed")
SEED_ADMIN_EMAIL=admin@storeratings.com
SEED_ADMIN_PASSWORD=Admin@12345
